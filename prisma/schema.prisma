datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  USER
  ADMIN
  MODERATOR
  EDITOR
  AUTHOR
  ANALYST
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityType {
  WALK
  RUN
  CYCLED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  NEEDS_REVIEW
  NOT_VERIFIED
  MANUAL_REVIEW
}

enum ActivityProcessingStatus {
  TRACKING
  VERIFYING
  REWARDING
  COMPLETED
  FAILED
}

enum ChallengeType {
  DAILY
  WEEKLY
  MONTHLY
  EVENT
}

enum ChallengeTrustLevel {
  GPS_VERIFIED_ONLY
  HABIT_SELF_REPORT // Catatan: Self-report selalu 0 XP & 0 HP kompetitif
}

enum ChallengeMetric {
  DISTANCE_METERS
  DURATION_SECONDS
  VERIFIED_ACTIVITY_COUNT
}

enum ChallengeCategory {
  CARDIO
  MOBILITY
  STRENGTH
  NUTRITION
  RECOVERY
  HABIT
}

enum Tier {
  SPROUT
  SEEDLING
  BLOOM
  VITAL
  RADIANT
  PEAK
  ELITE
  APEX
  LEGEND
}

enum LeaderboardScope {
  LEAGUE
  FRIENDS
  LOCAL
}

enum LedgerType {
  XP_GRANT
  XP_REVERSAL
  HP_GRANT
  HP_REDEEM
  HP_REFUND
  HP_EXPIRED
  HP_REVERSAL
}

enum RedemptionStatus {
  PENDING
  FULFILLED
  CANCELLED
  EXPIRED
}

enum PrivacyLevel {
  PRIVATE
  CIRCLE
  COMMUNITY
  PUBLIC
}

enum ShareTemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ShareTemplateAspectRatio {
  SQUARE
  PORTRAIT
  STORY
  LANDSCAPE
}

enum AppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum CompanionSender {
  USER
  ASSISTANT
}

enum DeviceType {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  SYSTEM
  REMINDER
  CHALLENGE
  CHEAT_ALERT
  WEEKLY_LETTER
  REWARD
  SOCIAL
  EVENT
  ACTIVITY
}

enum GuildRole {
  OWNER
  ADMIN
  MEMBER
}

enum PostReactionType {
  ENCOURAGE
  SUPPORT
  CELEBRATE
}

enum MomentLikerListVisibility {
  AUDIENCE
  OWNER_ONLY
}

enum MomentCommentMode {
  AUDIENCE
  FRIENDS_ONLY
  OFF
}

enum EventRegistrationStatus {
  JOINED
  CANCELLED
  ATTENDED
}

enum EventApprovalStatus {
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
  CANCELLED
}

enum ExternalLinkStatus {
  NONE
  PENDING_REVIEW
  APPROVED
  REJECTED
  DISABLED
}

enum EventCommentStatus {
  VISIBLE
  HIDDEN
}

enum CommunityApprovalStatus {
  PENDING_REVIEW
  NEEDS_REVISION
  APPROVED
  REJECTED
  ARCHIVED
}

enum CommunityJoinPolicy {
  OPEN
  APPROVAL
}

enum CommunityMemberStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum PostKind {
  ACTIVITY
  CONSISTENCY
  REFLECTION
}

enum CmsPublicationStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// ==========================================
// 1. AKUN, PROFIL, PREFERENSI & SETTINGS
// ==========================================

model User {
  id                String    @id @default(uuid())
  authUserId        String?   @unique // ID from Supabase Auth; nullable while legacy/demo rows are migrated.
  email             String    @unique
  username          String?   @unique
  usernameUpdatedAt DateTime?
  name              String
  bio               String?
  avatarUrl         String?
  role              UserRole  @default(USER)
  isSuspended       Boolean   @default(false)
  suspendedAt       DateTime?
  suspensionReason  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relationships
  healthProfile           HealthProfile?
  companionPreference     CompanionPreference?
  settings                UserSettings?
  economy                 UserEconomy?
  activitySessions        ActivitySession[]
  appeals                 Appeal[]
  xpGrants                XPGrant[]
  hpLedgerEntries         HPLedgerEntry[]
  challengeProgresses     ChallengeProgress[]
  challengeContributions  ChallengeContribution[]
  badges                  UserBadge[]
  rankings                Ranking[]
  redemptions             Redemption[]
  journeyEntries          JourneyEntry[]
  journalEntries          JournalEntry[]
  nutritionEntries        NutritionEntry[]
  waterLogs               WaterLog[]
  customFoodItems         CustomFoodItem[]
  healthPulses            HealthPulse[]
  healthMetrics           HealthMetric[]
  moments                 Moment[]
  reportsSubmitted        ContentReport[]           @relation("ReportedBy")
  auditLogs               AuditLog[]                @relation("ActorUser")
  notifications           UserNotification[]
  deviceTokens            UserDeviceToken[]
  companionConversations  CompanionConversation[]
  companionMemories       CompanionMemory[]
  weeklyLetters           WeeklyLetterArchive[]
  journalReactions        JournalReaction[]
  guildsLed               Guild[]                   @relation("GuildLeader")
  guildsReviewed          Guild[]                   @relation("GuildReviewer")
  guildMemberships        GuildMember[]
  posts                   Post[]
  postComments            PostComment[]
  postReactions           PostReaction[]
  momentReactions         MomentReaction[]
  momentComments          MomentComment[]
  momentBookmarks         MomentBookmark[]
  mutesCreated            UserMute[]                @relation("UserMuter")
  mutesReceived           UserMute[]                @relation("UserMuted")
  shareTemplatesCreated   ShareTemplate[]           @relation("ShareTemplateCreator")
  shareTemplatesPublished ShareTemplate[]           @relation("ShareTemplatePublisher")
  eventRegistrations      EventRegistration[]
  eventsCreated           Event[]                   @relation("EventCreator")
  eventsReviewed          Event[]                   @relation("EventReviewer")
  eventComments           EventComment[]            @relation("EventCommentAuthor")
  eventCommentsModerated  EventComment[]            @relation("EventCommentModerator")
  connectionsSent         UserConnection[]          @relation("ConnectionRequester")
  connectionsReceived     UserConnection[]          @relation("ConnectionAddressee")
  connectionsBlocked      UserConnection[]          @relation("ConnectionBlocker")
  cmsArticlesCreated      CmsArticle[]              @relation("CmsArticleAuthor")
  cmsArticlesUpdated      CmsArticle[]              @relation("CmsArticleUpdater")
  cmsArticlesPublished    CmsArticle[]              @relation("CmsArticlePublisher")
  cmsMediaUploaded        CmsMedia[]                @relation("CmsMediaUploader")
  cmsRevisionsCreated     CmsArticleRevision[]      @relation("CmsRevisionAuthor")
  cmsStatusChanges        CmsArticleStatusHistory[] @relation("CmsStatusChanger")

  @@map("users")
}

model HealthProfile {
  id                       String    @id @default(uuid())
  userId                   String    @unique
  birthDate                DateTime?
  gender                   Gender    @default(PREFER_NOT_TO_SAY)
  heightCm                 Float?
  weightKg                 Float?
  targetWeightKg           Float?
  activityLevel            String? // Baseline tingkat aktivitas
  healthGoals              String? // Tujuan kesehatan
  preferredActivities      String[]  @default([])
  dietaryPreferences       String[]  @default([])
  allergies                String[]  @default([])
  favoriteFoods            String[]  @default([])
  favoriteWorkoutTime      String?
  onboardingCompleted      Boolean   @default(false)
  dailyStepTarget          Int       @default(8000)
  dailyCalorieTarget       Int       @default(2000)
  dailyProteinTargetGrams  Int       @default(80)
  dailyCarbTargetGrams     Int       @default(220)
  dailyFiberTargetGrams    Int       @default(25)
  dailyWaterTargetMl       Int       @default(2000)
  dailySleepTargetHours    Float     @default(8)
  dailyActiveTargetMinutes Int       @default(30)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_profiles")
}

model CompanionPreference {
  id                           String   @id @default(uuid())
  userId                       String   @unique
  companionName                String   @default("Nora") // Hanya diubah di Profil
  companionAvatarId            String   @default("sparkles")
  morningBriefEnabled          Boolean  @default(true)
  weeklyLetterEnabled          Boolean  @default(true)
  breakReminderEnabled         Boolean  @default(false) // Default off
  breakReminderIntervalMinutes Int      @default(60)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companion_preferences")
}

model UserSettings {
  id                          String                    @id @default(uuid())
  userId                      String                    @unique
  profileVisibility           PrivacyLevel              @default(PUBLIC)
  pulseVisibility             PrivacyLevel              @default(PRIVATE)
  activityVisibility          PrivacyLevel              @default(CIRCLE)
  locationPermissionGranted   Boolean                   @default(false)
  darkTheme                   Boolean                   @default(true)
  leaderboardVisible          Boolean                   @default(true)
  challengeProgressVisible    Boolean                   @default(true)
  notificationsActivity       Boolean                   @default(true)
  notificationsLeaderboard    Boolean                   @default(true)
  notificationsSocial         Boolean                   @default(false)
  notificationsMomentLikes    Boolean                   @default(true)
  notificationsMomentComments Boolean                   @default(true)
  notificationsCommunity      Boolean                   @default(true)
  defaultMomentShowLikeCount  Boolean                   @default(true)
  defaultMomentLikerList      MomentLikerListVisibility @default(AUDIENCE)
  defaultMomentComments       MomentCommentMode         @default(AUDIENCE)
  momentHiddenWords           String[]                  @default([])
  companionInsightsEnabled    Boolean                   @default(true)
  companionSafetyNotesEnabled Boolean                   @default(true)
  useDemoData                 Boolean                   @default(true)
  showSimulationLabels        Boolean                   @default(true)
  gpsSimulationEnabled        Boolean                   @default(true)
  foodSimulationEnabled       Boolean                   @default(true)
  timezone                    String                    @default("Asia/Jakarta")
  leaderboardRegion           String?
  rawGpsRetentionDays         Int                       @default(30)
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserNotification {
  id             String           @id @default(uuid())
  userId         String
  type           NotificationType @default(SYSTEM)
  title          String
  message        String
  isRead         Boolean          @default(false)
  readAt         DateTime?
  archivedAt     DateTime?
  expiresAt      DateTime?
  requiresAction Boolean          @default(false)
  processingAt   DateTime?
  resolvedAt     DateTime?
  actionUrl      String?
  actionKey      String?
  dedupeKey      String?          @unique
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, archivedAt, createdAt])
  @@index([userId, actionKey, resolvedAt])
  @@map("user_notifications")
}

model UserDeviceToken {
  id         String     @id @default(uuid())
  userId     String
  fcmToken   String     @unique
  deviceType DeviceType @default(ANDROID)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("user_device_tokens")
}

// ==========================================
// 2. CHPS ECONOMY & LEDGER (SERVER-SIDE IDEMPOTENT)
// ==========================================

model UserEconomy {
  id             String    @id @default(uuid())
  userId         String    @unique
  totalXp        Int       @default(0) // XP akumulatif (tidak berkurang)
  currentHp      Int       @default(0) // HP dapat dibelanjakan
  hpDebt         Int       @default(0) // Reversal yang belum tertutup oleh grant HP berikutnya
  currentTier    Tier      @default(SPROUT)
  streakDays     Int       @default(0)
  lastActiveDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_economies")
}

model XPGrant {
  id                 String     @id @default(uuid())
  userId             String
  activitySessionId  String?
  challengeId        String?
  idempotencyKey     String     @unique // Mencegah pendelegasian ganda
  type               LedgerType @default(XP_GRANT)
  amount             Int
  capApplied         Boolean    @default(false) // Penanda cap harian
  diminishingApplied Boolean    @default(false) // Penanda diminishing return
  reason             String
  effectiveAt        DateTime   @default(now())
  createdAt          DateTime   @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activitySession   ActivitySession?   @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)
  challenge         Challenge?         @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  claimedByProgress ChallengeProgress? @relation("ClaimedXpGrant")

  @@index([userId, createdAt])
  @@index([userId, effectiveAt])
  @@index([activitySessionId])
  @@index([challengeId])
  @@map("xp_grants")
}

model HPLedgerEntry {
  id                 String     @id @default(uuid())
  userId             String
  type               LedgerType
  idempotencyKey     String     @unique // Mencegah transaksi ganda
  amount             Int // Positif (Grant) atau Negatif (Redeem)
  activitySessionId  String?
  challengeId        String?
  redemptionId       String?
  description        String
  capApplied         Boolean    @default(false)
  diminishingApplied Boolean    @default(false)
  effectiveAt        DateTime   @default(now())
  createdAt          DateTime   @default(now())

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  activitySession   ActivitySession?   @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)
  challenge         Challenge?         @relation(fields: [challengeId], references: [id], onDelete: SetNull)
  redemption        Redemption?        @relation(fields: [redemptionId], references: [id], onDelete: SetNull)
  claimedByProgress ChallengeProgress? @relation("ClaimedHpLedger")

  @@index([userId, createdAt])
  @@index([userId, effectiveAt])
  @@index([activitySessionId])
  @@index([challengeId])
  @@index([redemptionId])
  @@map("hp_ledger_entries")
}

// ==========================================
// 3. AKTIVITAS GPS & VERIFIKASI ANTI-CHEAT
// ==========================================

model ActivitySession {
  id                        String                   @id @default(uuid())
  userId                    String
  clientSessionId           String?
  activityType              ActivityType
  startTime                 DateTime
  endTime                   DateTime?
  durationSeconds           Int                      @default(0)
  activeDurationSeconds     Int                      @default(0)
  pausedDurationSeconds     Int                      @default(0)
  distanceMeters            Float                    @default(0)
  averagePace               Float                    @default(0) // detik per km
  caloriesBurned            Float                    @default(0)
  verificationStatus        VerificationStatus       @default(PENDING)
  isSimulated               Boolean                  @default(false)
  deviceAttestationVerified Boolean                  @default(false)
  processingStatus          ActivityProcessingStatus @default(TRACKING)
  processingAttempts        Int                      @default(0)
  lastProcessingError       String?
  rewardProcessedAt         DateTime?
  challengeProcessedAt      DateTime?
  badgeProcessedAt          DateTime?
  finalizedAt               DateTime?
  processingLeaseToken      String?
  processingLeaseUntil      DateTime?
  telemetrySampleCount      Int                      @default(0)
  telemetryDigest           String?                  @unique
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  telemetrySamples       TelemetrySample[]
  verificationResult     VerificationResult?
  appeals                Appeal[]
  xpGrants               XPGrant[]
  hpLedgerEntries        HPLedgerEntry[]
  moments                Moment[]
  journeyEntries         JourneyEntry[]
  challengeContributions ChallengeContribution[]
  posts                  Post[]

  @@unique([userId, clientSessionId])
  @@index([userId, startTime])
  @@index([verificationStatus, createdAt])
  @@index([processingStatus, updatedAt])
  @@map("activity_sessions")
}

model TelemetrySample {
  id                String   @id @default(uuid())
  activitySessionId String
  sequenceNumber    Int?
  segmentNumber     Int      @default(0)
  timestamp         DateTime
  latitude          Float
  longitude         Float
  altitude          Float?
  accuracy          Float? // Akurasi sinyal GPS
  speed             Float? // Kecepatan dalam m/s
  createdAt         DateTime @default(now())

  activitySession ActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)

  @@unique([activitySessionId, sequenceNumber])
  @@unique([activitySessionId, timestamp])
  @@index([activitySessionId, segmentNumber, sequenceNumber], map: "telemetry_activity_segment_sequence_idx")
  @@map("telemetry_samples")
}

model VerificationResult {
  id                        String             @id @default(uuid())
  activitySessionId         String             @unique
  verificationStatus        VerificationStatus
  reasonCodes               String[] // Array kode alasan netral
  riskScore                 Float              @default(0) // 0 - 100
  trustedDistanceMeters     Float              @default(0)
  trustedDurationSeconds    Int                @default(0)
  eligibleXp                Int                @default(0)
  eligibleHp                Int                @default(0)
  sampleCount               Int                @default(0)
  acceptedSampleCount       Int                @default(0)
  discardedSampleCount      Int                @default(0)
  maxSpeedKmh               Float              @default(0)
  largestSampleGapSeconds   Float              @default(0)
  deviceAttestationVerified Boolean            @default(false)
  processedAt               DateTime           @default(now())

  activitySession ActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)

  @@map("verification_results")
}

model Appeal {
  id                String       @id @default(uuid())
  activitySessionId String
  userId            String
  reason            String // Alasan pengajuan banding pengguna
  status            AppealStatus @default(PENDING)
  reviewerAdminId   String?
  reviewNotes       String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  activitySession ActivitySession @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("appeals")
}

// ==========================================
// 4. COMPANION AI & WEEKLY LETTER
// ==========================================

model CompanionConversation {
  id             String          @id @default(uuid())
  userId         String
  sender         CompanionSender
  content        String
  emotionContext String?
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("companion_conversations")
}

model CompanionMemory {
  id          String   @id @default(uuid())
  userId      String
  memoryKey   String // Misal: "user_allergy", "favorite_workout"
  memoryValue String
  category    String   @default("GENERAL")
  importance  Int      @default(1)
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companion_memories")
}

model WeeklyLetterArchive {
  id            String   @id @default(uuid())
  userId        String
  weekStart     DateTime
  weekEnd       DateTime
  letterTitle   String
  letterContent String
  summaryJson   Json?
  generatedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
  @@map("weekly_letter_archives")
}

// ==========================================
// 5. CHALLENGE & BADGES
// ==========================================

model Challenge {
  id           String              @id @default(uuid())
  title        String
  description  String
  type         ChallengeType
  category     ChallengeCategory   @default(CARDIO)
  trustLevel   ChallengeTrustLevel @default(GPS_VERIFIED_ONLY)
  metric       ChallengeMetric     @default(DISTANCE_METERS)
  activityType ActivityType?
  targetValue  Float // Misal 5.0 (km)
  targetUnit   String // "km", "minutes", "days"
  bonusXp      Int                 @default(0)
  bonusHp      Int                 @default(0)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  progresses      ChallengeProgress[]
  contributions   ChallengeContribution[]
  xpGrants        XPGrant[]
  hpLedgerEntries HPLedgerEntry[]

  @@map("challenges")
}

model ChallengeProgress {
  id                     String    @id @default(uuid())
  userId                 String
  challengeId            String
  currentValue           Float     @default(0)
  isCompleted            Boolean   @default(false)
  completedAt            DateTime?
  claimedXpGrantId       String?   @unique
  claimedHpLedgerEntryId String?   @unique
  claimVersion           Int       @default(0)
  rewardReversedAt       DateTime?
  lastContributedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge            Challenge               @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  claimedXpGrant       XPGrant?                @relation("ClaimedXpGrant", fields: [claimedXpGrantId], references: [id], onDelete: SetNull)
  claimedHpLedgerEntry HPLedgerEntry?          @relation("ClaimedHpLedger", fields: [claimedHpLedgerEntryId], references: [id], onDelete: SetNull)
  contributions        ChallengeContribution[]

  @@unique([userId, challengeId])
  @@map("challenge_progresses")
}

model ChallengeContribution {
  id                  String   @id @default(uuid())
  userId              String
  challengeId         String
  challengeProgressId String
  activitySessionId   String
  amount              Float
  createdAt           DateTime @default(now())

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge         Challenge         @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeProgress ChallengeProgress @relation(fields: [challengeProgressId], references: [id], onDelete: Cascade)
  activitySession   ActivitySession   @relation(fields: [activitySessionId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, activitySessionId], map: "challenge_contributions_challengeId_userId_activitySessionId_ke")
  @@index([challengeProgressId, createdAt])
  @@index([activitySessionId])
  @@map("challenge_contributions")
}

model Badge {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String
  iconUrl     String
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

// ==========================================
// 6. LEADERBOARD & SEASONS
// ==========================================

model LeaderboardSeason {
  id        String   @id @default(uuid())
  name      String // Misal "Season 1 - Summer 2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rankings Ranking[]

  @@map("leaderboard_seasons")
}

model Ranking {
  id               String           @id @default(uuid())
  seasonId         String
  userId           String
  scope            LeaderboardScope @default(LEAGUE)
  tier             Tier             @default(SPROUT)
  rankPosition     Int
  totalVerifiedXp  Int              @default(0)
  consistencyScore Float            @default(0)
  updatedAt        DateTime         @updatedAt

  season LeaderboardSeason @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([seasonId, userId, scope])
  @@map("rankings")
}

// ==========================================
// 7. REWARD STORE
// ==========================================

model Reward {
  id          String    @id @default(uuid())
  title       String
  description String
  partnerName String
  imageUrl    String
  hpCost      Int
  stock       Int       @default(0)
  expiryDate  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  redemptions Redemption[]

  @@map("rewards")
}

model Redemption {
  id                   String           @id @default(uuid())
  userId               String
  rewardId             String
  hpSpent              Int
  status               RedemptionStatus @default(PENDING)
  redemptionCode       String           @unique
  fulfilledAt          DateTime?
  cancelledAt          DateTime?
  expiresAt            DateTime?
  fulfillmentReference String?
  statusReason         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward          Reward          @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  hpLedgerEntries HPLedgerEntry[]

  @@map("redemptions")
}

// ==========================================
// 8. JOURNEY, JOURNAL PRIVAT, NUTRISI & HEALTH PULSE
// ==========================================

model JourneyEntry {
  id                String       @id @default(uuid())
  userId            String
  entryDate         DateTime     @default(now())
  activitySessionId String?
  nutritionEntryId  String?
  journalEntryId    String?
  privacyLevel      PrivacyLevel @default(PRIVATE)
  createdAt         DateTime     @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activitySession ActivitySession? @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)
  nutritionEntry  NutritionEntry?  @relation(fields: [nutritionEntryId], references: [id], onDelete: SetNull)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)

  @@map("journey_entries")
}

model JournalEntry {
  id             String   @id @default(uuid())
  userId         String
  title          String   @default("Catatan kesehatan")
  content        String // Jurnal privat pengguna
  mood           String?
  allowCompanion Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  journeyEntries JourneyEntry[]
  attachments    JournalAttachment[]
  reactions      JournalReaction[]

  @@map("journal_entries")
}

model JournalAttachment {
  id             String @id @default(uuid())
  journalEntryId String
  fileUrl        String
  fileType       String @default("IMAGE")

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@map("journal_attachments")
}

model JournalReaction {
  id             String   @id @default(uuid())
  journalEntryId String
  userId         String
  reaction       String // LIKES, SUPPORT, CELEBRATE
  createdAt      DateTime @default(now())

  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([journalEntryId, userId])
  @@map("journal_reactions")
}

model NutritionEntry {
  id                 String   @id @default(uuid())
  userId             String
  foodItemId         String?
  foodName           String
  portionGrams       Float?
  calories           Float    @default(0)
  protein            Float    @default(0)
  carbs              Float    @default(0)
  fat                Float    @default(0)
  fiber              Float    @default(0)
  sugar              Float    @default(0)
  sodiumMg           Float    @default(0)
  mealType           String?
  source             String   @default("MANUAL")
  isUserConfirmed    Boolean  @default(true)
  confidenceScore    Float    @default(0) // Estimasi keandalan AI
  imageUrl           String?
  recommendationText String? // Saran langkah kecil
  loggedAt           DateTime @default(now())
  createdAt          DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  foodItem       FoodItem?      @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  journeyEntries JourneyEntry[]

  @@index([userId, createdAt])
  @@index([userId, loggedAt])
  @@index([foodItemId])
  @@map("nutrition_entries")
}

model FoodItem {
  id              String   @id @default(uuid())
  source          String   @default("LOCAL")
  externalId      String?
  name            String
  brand           String?
  caloriesPer100g Float
  proteinPer100g  Float    @default(0)
  carbsPer100g    Float    @default(0)
  fatPer100g      Float    @default(0)
  fiberPer100g    Float    @default(0)
  sugarPer100g    Float    @default(0)
  sodiumMgPer100g Float    @default(0)
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  nutritionEntries NutritionEntry[]

  @@unique([source, externalId])
  @@index([name])
  @@map("food_items")
}

model WaterLog {
  id       String   @id @default(uuid())
  userId   String
  volumeMl Int
  loggedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loggedAt])
  @@map("water_logs")
}

model CustomFoodItem {
  id              String   @id @default(uuid())
  userId          String
  name            String
  caloriesPer100g Float
  proteinPer100g  Float    @default(0)
  carbsPer100g    Float    @default(0)
  fatPer100g      Float    @default(0)
  isPublic        Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("custom_food_items")
}

model NutritionSearchCache {
  id           String   @id @default(uuid())
  queryHash    String   @unique
  queryText    String
  responseJson Json
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([queryHash])
  @@map("nutrition_search_caches")
}

model HealthPulse {
  id              String   @id @default(uuid())
  userId          String
  pulseDate       DateTime @default(now()) @db.Date
  overallScore    Float    @default(0)
  nutritionScore  Float    @default(0)
  activityScore   Float    @default(0)
  sleepHours      Float?
  hydrationLiters Float?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, pulseDate])
  @@index([userId, pulseDate])
  @@map("health_pulses")
}

model HealthMetric {
  id         String   @id @default(uuid())
  userId     String
  weightKg   Float?
  heightCm   Float?
  bmi        Float?
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, recordedAt])
  @@map("health_metrics")
}

// ==========================================
// 9. KOMUNITAS, EVENTS & NUTRIVERSE MOMENTS
// ==========================================

model Event {
  id                 String               @id @default(uuid())
  title              String
  description        String
  bannerUrl          String
  startDate          DateTime
  endDate            DateTime
  location           String?
  capacity           Int                  @default(0)
  bonusXp            Int                  @default(0)
  bonusHp            Int                  @default(0)
  isActive           Boolean              @default(true)
  status             CmsPublicationStatus @default(PUBLISHED)
  slug               String?              @unique
  publishedAt        DateTime?
  createdByUserId    String?
  updatedByUserId    String?
  approvalStatus     EventApprovalStatus  @default(APPROVED)
  reviewNote         String?
  reviewedByUserId   String?
  reviewedAt         DateTime?
  whatsappInviteUrl  String?
  whatsappLinkStatus ExternalLinkStatus   @default(NONE)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  registrations EventRegistration[]
  comments      EventComment[]
  createdBy     User?               @relation("EventCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy    User?               @relation("EventReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([isActive, startDate])
  @@index([approvalStatus, createdAt])
  @@index([createdByUserId, approvalStatus])
  @@map("events")
}

model EventComment {
  id            String             @id @default(uuid())
  eventId       String
  authorId      String
  parentId      String?
  content       String
  status        EventCommentStatus @default(VISIBLE)
  isPinned      Boolean            @default(false)
  moderatedById String?
  moderatedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event       Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author      User           @relation("EventCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent      EventComment?  @relation("EventCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     EventComment[] @relation("EventCommentReplies")
  moderatedBy User?          @relation("EventCommentModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([eventId, isPinned, createdAt])
  @@index([authorId, createdAt])
  @@index([parentId])
  @@map("event_comments")
}

model CmsCategory {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  articles    CmsArticle[]

  @@map("cms_categories")
}

model CmsArticle {
  id                String               @id @default(uuid())
  title             String
  slug              String               @unique
  excerpt           String?
  content           String
  coverImageUrl     String?
  status            CmsPublicationStatus @default(DRAFT)
  isFeatured        Boolean              @default(false)
  publishedAt       DateTime?
  scheduledAt       DateTime?
  categoryId        String?
  authorUserId      String
  updatedByUserId   String?
  publishedByUserId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  rejectionReason   String?
  autosavedAt       DateTime?

  category      CmsCategory?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags          CmsArticleTag[]
  author        User                      @relation("CmsArticleAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  updatedBy     User?                     @relation("CmsArticleUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  publishedBy   User?                     @relation("CmsArticlePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  media         CmsMedia[]
  revisions     CmsArticleRevision[]
  statusHistory CmsArticleStatusHistory[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@map("cms_articles")
}

model CmsArticleRevision {
  id            String               @id @default(uuid())
  articleId     String
  version       Int
  title         String
  slug          String
  excerpt       String?
  content       String
  coverImageUrl String?
  status        CmsPublicationStatus
  savedByUserId String
  createdAt     DateTime             @default(now())

  article CmsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  savedBy User       @relation("CmsRevisionAuthor", fields: [savedByUserId], references: [id], onDelete: Restrict)

  @@unique([articleId, version])
  @@index([articleId, createdAt])
  @@map("cms_article_revisions")
}

model CmsArticleStatusHistory {
  id              String                @id @default(uuid())
  articleId       String
  fromStatus      CmsPublicationStatus?
  toStatus        CmsPublicationStatus
  reason          String?
  changedByUserId String
  createdAt       DateTime              @default(now())

  article   CmsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  changedBy User       @relation("CmsStatusChanger", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@map("cms_article_status_history")
}

model CmsMedia {
  id           String   @id @default(uuid())
  url          String
  storagePath  String   @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  altText      String?
  articleId    String?
  uploadedById String
  createdAt    DateTime @default(now())

  article    CmsArticle? @relation(fields: [articleId], references: [id], onDelete: SetNull)
  uploadedBy User        @relation("CmsMediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt])
  @@map("cms_media")
}

model CmsTag {
  id        String          @id @default(uuid())
  name      String
  slug      String          @unique
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  articles  CmsArticleTag[]

  @@map("cms_tags")
}

model CmsArticleTag {
  articleId String
  tagId     String
  article   CmsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       CmsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
  @@map("cms_article_tags")
}

model EventRegistration {
  id         String                  @id @default(uuid())
  eventId    String
  userId     String
  status     EventRegistrationStatus @default(JOINED)
  joinedAt   DateTime                @default(now())
  attendedAt DateTime?
  updatedAt  DateTime                @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId, status])
  @@map("event_registrations")
}

model UserConnection {
  id          String           @id @default(uuid())
  pairKey     String           @unique
  requesterId String
  addresseeId String
  blockedById String?
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User  @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User  @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  blockedBy User? @relation("ConnectionBlocker", fields: [blockedById], references: [id], onDelete: SetNull)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@index([blockedById])
  @@map("user_connections")
}

model Guild {
  id               String                  @id @default(uuid())
  name             String                  @unique
  description      String?
  emblemUrl        String?
  category         String                  @default("Gaya Hidup Sehat")
  rules            String[]                @default([])
  joinPolicy       CommunityJoinPolicy     @default(OPEN)
  approvalStatus   CommunityApprovalStatus @default(APPROVED)
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  approvedAt       DateTime?
  isActive         Boolean                 @default(true)
  leaderId         String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  leader     User?         @relation("GuildLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  reviewedBy User?         @relation("GuildReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  members    GuildMember[]
  posts      Post[]
  moments    Moment[]

  @@index([leaderId])
  @@index([approvalStatus, isActive, createdAt])
  @@index([reviewedByUserId])
  @@map("guilds")
}

model GuildMember {
  id               String                @id @default(uuid())
  guildId          String
  userId           String
  role             GuildRole             @default(MEMBER)
  status           CommunityMemberStatus @default(ACTIVE)
  visibleOnProfile Boolean               @default(false)
  joinedAt         DateTime              @default(now())
  approvedAt       DateTime?
  updatedAt        DateTime              @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId, status])
  @@index([guildId, status])
  @@map("guild_members")
}

model Post {
  id                String       @id @default(uuid())
  userId            String
  guildId           String?
  activitySessionId String?
  content           String
  imageUrl          String?
  privacyLevel      PrivacyLevel @default(CIRCLE)
  kind              PostKind     @default(REFLECTION)
  isHidden          Boolean      @default(false)
  isPinned          Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  guild           Guild?           @relation(fields: [guildId], references: [id], onDelete: SetNull)
  activitySession ActivitySession? @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)
  comments        PostComment[]
  reactions       PostReaction[]
  reports         ContentReport[]

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([guildId, createdAt])
  @@map("posts")
}

model PostComment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  content   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ContentReport[]

  @@index([postId, createdAt])
  @@index([userId, createdAt])
  @@map("post_comments")
}

model PostReaction {
  id        String           @id @default(uuid())
  postId    String
  userId    String
  type      PostReactionType @default(ENCOURAGE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@map("post_reactions")
}

model Moment {
  id                   String                    @id @default(uuid())
  userId               String
  activitySessionId    String?
  communityId          String?
  shareTemplateId      String?
  shareTemplateVersion Int?
  metricsSnapshot      Json?
  imageUrl             String // Foto kamera langsung
  caption              String?
  duringActivity       Boolean                   @default(false)
  privacyLevel         PrivacyLevel              @default(PRIVATE)
  visibleOnProfile     Boolean                   @default(false)
  profileDisplayOrder  Int?
  showLikeCount        Boolean                   @default(true)
  likerListVisibility  MomentLikerListVisibility @default(AUDIENCE)
  commentsMode         MomentCommentMode         @default(AUDIENCE)
  isArchived           Boolean                   @default(false)
  reportCount          Int                       @default(0)
  isHidden             Boolean                   @default(false)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activitySession ActivitySession? @relation(fields: [activitySessionId], references: [id], onDelete: SetNull)
  community       Guild?           @relation(fields: [communityId], references: [id], onDelete: SetNull)
  shareTemplate   ShareTemplate?   @relation(fields: [shareTemplateId], references: [id], onDelete: SetNull)
  reports         ContentReport[]
  reactions       MomentReaction[]
  comments        MomentComment[]
  bookmarks       MomentBookmark[]

  @@index([privacyLevel, createdAt])
  @@index([userId, createdAt])
  @@index([userId, visibleOnProfile, profileDisplayOrder])
  @@index([userId, isArchived, createdAt])
  @@index([communityId, createdAt])
  @@index([shareTemplateId])
  @@map("moments")
}

model MomentReaction {
  id        String           @id @default(uuid())
  momentId  String
  userId    String
  type      PostReactionType @default(ENCOURAGE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([userId, createdAt])
  @@map("moment_reactions")
}

model MomentComment {
  id        String   @id @default(uuid())
  momentId  String
  userId    String
  content   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([momentId, createdAt])
  @@index([userId, createdAt])
  @@map("moment_comments")
}

model MomentBookmark {
  id        String   @id @default(uuid())
  momentId  String
  userId    String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([momentId, userId])
  @@index([userId, createdAt])
  @@map("moment_bookmarks")
}

model UserMute {
  id        String   @id @default(uuid())
  muterId   String
  mutedId   String
  createdAt DateTime @default(now())

  muter User @relation("UserMuter", fields: [muterId], references: [id], onDelete: Cascade)
  muted User @relation("UserMuted", fields: [mutedId], references: [id], onDelete: Cascade)

  @@unique([muterId, mutedId])
  @@index([mutedId])
  @@map("user_mutes")
}

model ShareTemplate {
  id                String                   @id @default(uuid())
  name              String
  description       String?
  category          String                   @default("Aktivitas")
  aspectRatio       ShareTemplateAspectRatio @default(SQUARE)
  width             Int                      @default(1080)
  height            Int                      @default(1080)
  backgroundUrl     String?
  thumbnailUrl      String?
  layoutConfig      Json
  allowedDataKeys   String[]                 @default([])
  status            ShareTemplateStatus      @default(DRAFT)
  version           Int                      @default(1)
  createdByUserId   String
  publishedByUserId String?
  publishedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  createdBy   User     @relation("ShareTemplateCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  publishedBy User?    @relation("ShareTemplatePublisher", fields: [publishedByUserId], references: [id], onDelete: SetNull)
  moments     Moment[]

  @@index([status, category, createdAt])
  @@index([createdByUserId])
  @@index([publishedByUserId])
  @@map("share_templates")
}

model ContentReport {
  id             String       @id @default(uuid())
  reporterUserId String
  momentId       String?
  postId         String?
  commentId      String?
  reason         String
  status         ReportStatus @default(PENDING)
  handledByAdmin String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  reporterUser User         @relation("ReportedBy", fields: [reporterUserId], references: [id], onDelete: Cascade)
  moment       Moment?      @relation(fields: [momentId], references: [id], onDelete: Cascade)
  post         Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      PostComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterUserId, momentId])
  @@unique([reporterUserId, postId])
  @@unique([reporterUserId, commentId])
  @@index([reporterUserId, createdAt])
  @@index([postId])
  @@index([commentId])
  @@map("content_reports")
}

// ==========================================
// 10. ADMIN & AUDIT LOG
// ==========================================

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String
  action      String // Misal: "APPROVE_APPEAL", "GRANT_MANUAL_XP"
  entityName  String // Misal: "ActivitySession", "Reward"
  entityId    String
  beforeState Json?
  afterState  Json?
  reason      String?
  createdAt   DateTime @default(now())

  actorUser User @relation("ActorUser", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model SystemSetting {
  id              String   @id @default(uuid())
  key             String   @unique
  value           Json
  updatedByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("system_settings")
}

model ApiRateLimitBucket {
  id          String   @id @default(uuid())
  bucketKey   String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@unique([bucketKey, windowStart])
  @@index([expiresAt])
  @@map("api_rate_limit_buckets")
}
